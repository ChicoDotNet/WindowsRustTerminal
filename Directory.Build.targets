<Project>
  <!--
    NOTE! This file gets written-over entirely by the release builds.
    Any build logic in this file must be optional and only apply to non-release builds.
  -->

  <ImportGroup Condition="'$(MSBuildCacheEnabled)' == 'true'">
    <Import Project="$(MSBuildCachePackageRoot)\build\$(MSBuildCachePackageName).targets" />
    <Import Project="$(MSBuildCacheSharedCompilationPackageRoot)\build\Microsoft.MSBuildCache.SharedCompilation.targets" />
  </ImportGroup>

  <!-- R09 product integration: keep native TerminalApp/Settings UI ownership while
       linking deterministic FZF behavior from the Rust static library. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TerminalAppLib' Or '$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.Editor'">
    <_RustTerminalAppTargetTriple Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</_RustTerminalAppTargetTriple>
    <_RustTerminalAppTargetTriple Condition="'$(Platform)' == 'Win32'">i686-pc-windows-msvc</_RustTerminalAppTargetTriple>
    <_RustTerminalAppTargetTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</_RustTerminalAppTargetTriple>
    <_RustTerminalAppCargoProfile Condition="'$(Configuration)' == 'Debug'">debug</_RustTerminalAppCargoProfile>
    <_RustTerminalAppCargoProfile Condition="'$(Configuration)' != 'Debug'">release</_RustTerminalAppCargoProfile>
    <_RustTerminalAppCargoReleaseArg Condition="'$(Configuration)' != 'Debug'">--release</_RustTerminalAppCargoReleaseArg>
    <_RustTerminalAppFfiLib>$(SolutionDir)artifacts\cargo-target\$(_RustTerminalAppTargetTriple)\$(_RustTerminalAppCargoProfile)\terminal_app_ffi.lib</_RustTerminalAppFfiLib>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'TerminalAppLib' Or '$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.Editor'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)rust\terminal-app-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'TerminalAppLib'">
    <Lib>
      <AdditionalDependencies>$(_RustTerminalAppFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.Editor'">
    <Link>
      <AdditionalDependencies>$(_RustTerminalAppFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="BuildRustTerminalAppFfi" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'TerminalAppLib' Or '$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.Editor'">
    <Error Condition="'$(_RustTerminalAppTargetTriple)' == ''" Text="R09 TerminalApp Rust integration does not support MSBuild platform '$(Platform)'." />
    <Exec WorkingDirectory="$(SolutionDir)" Command="rustup target add $(_RustTerminalAppTargetTriple)" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="cargo build --locked -p terminal-app-ffi --target $(_RustTerminalAppTargetTriple) $(_RustTerminalAppCargoReleaseArg)" />
  </Target>

  <!-- R09 PTY signal integration: Host keeps Win32/thread/pipe ownership while
       Rust owns deterministic signal classification and payload sizing. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'hostlib'">
    <_RustHostTargetTriple Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</_RustHostTargetTriple>
    <_RustHostTargetTriple Condition="'$(Platform)' == 'Win32'">i686-pc-windows-msvc</_RustHostTargetTriple>
    <_RustHostTargetTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</_RustHostTargetTriple>
    <_RustHostCargoProfile Condition="'$(Configuration)' == 'Debug'">debug</_RustHostCargoProfile>
    <_RustHostCargoProfile Condition="'$(Configuration)' != 'Debug'">release</_RustHostCargoProfile>
    <_RustHostCargoReleaseArg Condition="'$(Configuration)' != 'Debug'">--release</_RustHostCargoReleaseArg>
    <_RustHostFfiLib>$(SolutionDir)artifacts\cargo-target\$(_RustHostTargetTriple)\$(_RustHostCargoProfile)\terminal_parser_ffi.lib</_RustHostFfiLib>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'hostlib'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)rust\terminal-parser-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>$(_RustHostFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>

  <Target Name="BuildRustHostFfi" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'hostlib'">
    <Error Condition="'$(_RustHostTargetTriple)' == ''" Text="R09 Host Rust integration does not support MSBuild platform '$(Platform)'." />
    <Exec WorkingDirectory="$(SolutionDir)" Command="rustup target add $(_RustHostTargetTriple)" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="cargo build --locked -p terminal-parser-ffi --target $(_RustHostTargetTriple) $(_RustHostCargoReleaseArg)" />
  </Target>

  <!-- R09 settings integration: C++/WinRT keeps state storage and persistence while
       Rust owns deterministic workspace-rename policy. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.ModelLib'">
    <_RustSettingsTargetTriple Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</_RustSettingsTargetTriple>
    <_RustSettingsTargetTriple Condition="'$(Platform)' == 'Win32'">i686-pc-windows-msvc</_RustSettingsTargetTriple>
    <_RustSettingsTargetTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</_RustSettingsTargetTriple>
    <_RustSettingsCargoProfile Condition="'$(Configuration)' == 'Debug'">debug</_RustSettingsCargoProfile>
    <_RustSettingsCargoProfile Condition="'$(Configuration)' != 'Debug'">release</_RustSettingsCargoProfile>
    <_RustSettingsCargoReleaseArg Condition="'$(Configuration)' != 'Debug'">--release</_RustSettingsCargoReleaseArg>
    <_RustSettingsFfiLib>$(SolutionDir)artifacts\cargo-target\$(_RustSettingsTargetTriple)\$(_RustSettingsCargoProfile)\terminal_settings_ffi.lib</_RustSettingsFfiLib>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.ModelLib'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)rust\terminal-settings-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>$(_RustSettingsFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>

  <Target Name="BuildRustSettingsFfi" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'Microsoft.Terminal.Settings.ModelLib'">
    <Error Condition="'$(_RustSettingsTargetTriple)' == ''" Text="R09 Settings Rust integration does not support MSBuild platform '$(Platform)'." />
    <Exec WorkingDirectory="$(SolutionDir)" Command="rustup target add $(_RustSettingsTargetTriple)" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="cargo build --locked -p terminal-settings-ffi --target $(_RustSettingsTargetTriple) $(_RustSettingsCargoReleaseArg)" />
  </Target>

  <!-- R09 renderer settings integration: native rendering/color ownership remains
       in RendererBase while Rust owns deterministic render-mode and blink policy. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'base'">
    <_RustRendererTargetTriple Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</_RustRendererTargetTriple>
    <_RustRendererTargetTriple Condition="'$(Platform)' == 'Win32'">i686-pc-windows-msvc</_RustRendererTargetTriple>
    <_RustRendererTargetTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</_RustRendererTargetTriple>
    <_RustRendererCargoProfile Condition="'$(Configuration)' == 'Debug'">debug</_RustRendererCargoProfile>
    <_RustRendererCargoProfile Condition="'$(Configuration)' != 'Debug'">release</_RustRendererCargoProfile>
    <_RustRendererCargoReleaseArg Condition="'$(Configuration)' != 'Debug'">--release</_RustRendererCargoReleaseArg>
    <_RustRendererFfiLib>$(SolutionDir)artifacts\cargo-target\$(_RustRendererTargetTriple)\$(_RustRendererCargoProfile)\terminal_parser_ffi.lib</_RustRendererFfiLib>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'base'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)rust\terminal-parser-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>$(_RustRendererFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>

  <Target Name="BuildRustRendererFfi" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'base'">
    <Error Condition="'$(_RustRendererTargetTriple)' == ''" Text="R09 Renderer Rust integration does not support MSBuild platform '$(Platform)'." />
    <Exec WorkingDirectory="$(SolutionDir)" Command="rustup target add $(_RustRendererTargetTriple)" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="cargo build --locked -p terminal-parser-ffi --target $(_RustRendererTargetTriple) $(_RustRendererCargoReleaseArg)" />
  </Target>
</Project>